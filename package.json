{
  "name": "openchess",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "next build",
    "start": "next start",
    "lint": "prettier . --write",
    "lint:check": "prettier . --check",
    "type-check": "tsc --noEmit",
    "db:make": "bun run bin/namu-it.ts",
    "clean": "rimraf .next out dist",
    "prebuild": "bun run clean",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "openings:build": "bun run bin/build-openings.ts"
  },
  "bin": {
    "namu-it": "./bin/namu-it.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "@types/mdx": "^2.0.14",
    "@vercel/speed-insights": "^2.0.0",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.25",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "react": "^19.3.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.0",
    "remark-toc": "^9.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "^16.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.5.30",
    "prettier": "3.9.10",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vercel": "^64.0.2"
  }
